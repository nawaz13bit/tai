{
  "claude": {
    "exe": "claude",
    "resume": ["--continue", "--remote-control", "{name}"],
    "fresh": ["--remote-control", "{name}"],
    "settingsFlag": "--settings",
    "configEnv": "CLAUDE_CONFIG_DIR",
    "defaultDir": "~/.claude",
    "bestFor": "careful multi-file changes, code review, planning, long agentic edits",
    "delegateHint": { "flag": "--append-system-prompt-file", "file": true, "resumeArgs": ["--system-prompt-snapshot", "off"] },
    "headless": { "args": [], "readonly": ["--permission-mode", "plan"], "edit": ["--permission-mode", "acceptEdits"], "allowFlag": "--allowedTools", "defaultAllow": ["Bash(git status:*)", "Bash(git log:*)", "Bash(git diff:*)", "Bash(git show:*)", "Bash(git --version)"],"prompt": ["-p"] }
  },
  "codex": {
    "exe": "codex",
    "configEnv": "CODEX_HOME",
    "defaultDir": "~/.codex",
    "args": ["--no-alt-screen"],
    "resume": ["resume", "--last"],
    "bestFor": "focused implementation, refactors, second-opinion code review, running and fixing tests",
    "delegateHint": { "flag": "-c", "value": "developer_instructions='{text}'" },
    "headless": { "args": ["exec", "--skip-git-repo-check", "--color", "never"], "readonly": ["-s", "read-only"], "edit": ["-s", "workspace-write"], "prompt": [] }
  },
  "agy": {
    "exe": "agy",
    "resume": ["--continue"],
    "bestFor": "reading and summarising large codebases or docs, research, quick read-only questions",
    "delegateHint": { "flag": "-i", "value": "{text}", "suffix": "This message is background information, not a task: do not run any tools, and reply with only the word ok." },
    "headless": { "args": [], "readonly": ["--mode", "accept-edits"], "readonlyDeny": ["write_file(*)"], "edit": ["--mode", "accept-edits"], "settingsFlag": "--settings", "defaultAllow": ["command(regex:git (status|log|diff|show|--version).*)"],"prompt": ["-p"] }
  },
  "opencode": {
    "exe": "opencode",
    "resume": ["--continue"],
    "env": { "OPENCODE_DISABLE_TERMINAL_TITLE": "1" }
  },
  "cursor": {
    "exe": "agent",
    "resume": ["--continue"]
  },
  "copilot": {
    "exe": "copilot",
    "args": ["--no-alt-screen"],
    "resume": ["--continue"]
  },
  "qwen": {
    "exe": "qwen",
    "resume": ["--continue"]
  }
}
